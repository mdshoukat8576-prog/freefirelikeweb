{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "{*.html,*.css,*.js,assets/**,blog/**,data/**,sitemap.xml,robots.txt,site.webmanifest,favicon.ico,node_modules/sql.js/dist/**}"
    },
    "server.js": {
      "includeFiles": "{*.html,*.css,*.js,assets/**,blog/**,data/**,sitemap.xml,robots.txt,site.webmanifest,favicon.ico,node_modules/sql.js/dist/**}"
    }
  },
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-of-service",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js"
    }
  ]
}
